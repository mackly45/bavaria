# URL publique du site (canonical, liens absolus)
VITE_SITE_URL=https://bavaria-premium.vercel.app

# Commandes : numéro WhatsApp international (ex. 242061234567) et/ou email
VITE_ORDER_WHATSAPP=
VITE_ORDER_EMAIL=

# Formulaires : endpoints compatibles Formspree (POST JSON). Sans endpoint, le contact passe par VITE_CONTACT_EMAIL.
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_EMAIL=
VITE_NEWSLETTER_ENDPOINT=

# Prix unitaires (JSON) et devise ISO 4217
VITE_PRICES=
VITE_CURRENCY=EUR

# Points de vente (JSON) : [{"name":"Magasin","address":"Adresse","lat":-4.26,"lng":15.28}]
VITE_STORES=

# Réseaux sociaux
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_X=
VITE_SOCIAL_FACEBOOK=

# Mentions légales
VITE_LEGAL_COMPANY=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_REGISTRATION=
VITE_LEGAL_DIRECTOR=
